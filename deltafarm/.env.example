# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env gehoert NIEMALS ins Repository - siehe .gitignore.

# --- Ausfuehrungsmodus ---------------------------------------------------
# true  = Orderpfade laufen vollstaendig durch, es wird aber nichts gesendet.
# false = echte Orders. Erst umstellen, wenn Phase 4 abgeschlossen ist.
DELTAFARM_DRY_RUN=true

# testnet | mainnet. Testnet ist Standard und bleibt es, bis du bewusst wechselst.
DELTAFARM_ENVIRONMENT=testnet

# --- Netzwerk ------------------------------------------------------------
# Die Anwendung bindet ausschliesslich an 127.0.0.1. Nicht aenderbar.
DELTAFARM_PORT=8787

# --- Extended ------------------------------------------------------------
# API-Management-Seite der jeweiligen Umgebung:
#   Testnet: https://starknet.sepolia.extended.exchange/api-management
#   Mainnet: https://starknet.extended.exchange/api-management
# Ab Phase 2 noetig. Phase 1 laeuft ohne Schluessel, da nur oeffentliche Endpunkte.
# Withdrawal-Rechte bei allen Schluesseln deaktiviert lassen.
EXTENDED_API_KEY=
EXTENDED_PUBLIC_KEY=
EXTENDED_PRIVATE_KEY=
EXTENDED_VAULT_ID=

# --- Lighter -------------------------------------------------------------
# Ab Phase 2 noetig. Phase 1 laeuft ohne Schluessel.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_PRIVATE_KEY=
